---
import '../styles/global.css';
import { EKAA_SITE, buildWhatsAppUrl, getVerticalHref } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  pageSchemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/images/sanctuary-hero.jpg',
  pageSchemas = [],
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, EKAA_SITE.siteUrl).toString();
const ogImageUrl = new URL(ogImage, EKAA_SITE.siteUrl).toString();

const riseLink = getVerticalHref(EKAA_SITE.verticals.rise);
const rejoiceLink = getVerticalHref(EKAA_SITE.verticals.rejoice);

const baseOrganizationAndPerson = [
  {
    '@type': 'Organization',
    '@id': `${EKAA_SITE.siteUrl}/#organization`,
    name: EKAA_SITE.brandName,
    alternateName: EKAA_SITE.flagshipName,
    url: `${EKAA_SITE.siteUrl}/`,
    logo: `${EKAA_SITE.siteUrl}/brand/ekaa-logo-terracotta.png`,
    email: EKAA_SITE.email,
    telephone: '+971562046096',
    areaServed: ['Dubai', 'United Arab Emirates', 'Worldwide Online'],
    founder: { '@id': `${EKAA_SITE.siteUrl}/#mehak-marwaha` },
    sameAs: [
      EKAA_SITE.verticals.radiance.instagramUrl,
      EKAA_SITE.verticals.rise.instagramUrl,
      EKAA_SITE.verticals.rejoice.instagramUrl,
    ],
    subOrganization: [
      {
        '@type': 'Organization',
        name: 'Ekaa Radiance',
        url: `${EKAA_SITE.siteUrl}/radiance/`,
        logo: `${EKAA_SITE.siteUrl}${EKAA_SITE.verticals.radiance.logoPath}`,
      },
      {
        '@type': 'Organization',
        name: 'Ekaa Rise',
        logo: `${EKAA_SITE.siteUrl}${EKAA_SITE.verticals.rise.logoPath}`,
        url: EKAA_SITE.verticals.rise.externalUrl || `${EKAA_SITE.siteUrl}/ekaa-family/#rise`,
      },
      {
        '@type': 'Organization',
        name: 'Ekaa Rejoice',
        logo: `${EKAA_SITE.siteUrl}${EKAA_SITE.verticals.rejoice.logoPath}`,
        url: EKAA_SITE.verticals.rejoice.externalUrl || `${EKAA_SITE.siteUrl}/ekaa-family/#rejoice`,
      },
    ],
  },
  {
    '@type': 'Person',
    '@id': `${EKAA_SITE.siteUrl}/#mehak-marwaha`,
    name: EKAA_SITE.founder.name,
    image: EKAA_SITE.founder.hasPortraitPhoto ? `${EKAA_SITE.siteUrl}${EKAA_SITE.founder.portraitPath}` : undefined,
    jobTitle: EKAA_SITE.founder.role,
    url: `${EKAA_SITE.siteUrl}/mehak-marwaha/`,
    worksFor: { '@id': `${EKAA_SITE.siteUrl}/#organization` },
    homeLocation: {
      '@type': 'Place',
      name: 'Dubai, United Arab Emirates',
    },
    knowsAbout: [
      'Vedic Numerology',
      'Lo Shu Grid',
      'Reiki Healing Energy',
      'Tarot Life Coaching',
      'Akashic Record Reading',
      'Meditation Practices',
      'Pendulum Dowsing',
      'Career Counseling',
    ],
  },
];

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [...baseOrganizationAndPerson, ...pageSchemas],
};

const whatsappQuickHref = buildWhatsAppUrl(
  'Hi Mehak, I visited ekaa.me and would love guidance on choosing a Radiance session.'
);

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/brand/ekaa-lotus-terracotta.png" />

    <!-- Open Graph / WhatsApp / Social Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EKAA — Ekaa Radiance" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Connected Entity Knowledge Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-lockup" aria-label="EKAA Radiance Home">
          <img src={EKAA_SITE.verticals.radiance.logoPath} alt="" width="250" height="250" />
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          {
            EKAA_SITE.nav.map((item) => {
              const isActive =
                item.href === '/radiance/'
                  ? currentPath.startsWith('/radiance')
                  : currentPath.startsWith(item.href);
              return (
                <a href={item.href} class:list={['nav-link', { active: isActive }]}>
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <div style="display:flex; align-items:center; gap:12px;">
          <a href="/book/" class="btn btn-primary header-cta" style="min-height:42px; padding:10px 22px;">
            Book a Session
          </a>
          <button
            type="button"
            class="mobile-menu-btn"
            id="mobile-menu-open"
            aria-label="Open navigation menu"
            aria-expanded="false"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <line x1="4" y1="8" x2="20" y2="8" />
              <line x1="8" y1="16" x2="20" y2="16" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Navigation Drawer -->
    <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <a href="/" class="brand-lockup" aria-label="EKAA Radiance Home">
          <img src={EKAA_SITE.verticals.radiance.logoPath} alt="" width="250" height="250" />
        </a>
        <button
          type="button"
          class="mobile-menu-btn"
          id="mobile-menu-close"
          aria-label="Close navigation menu"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>
      </div>

      <nav style="display:flex; flex-direction:column; gap:18px; margin:auto 0;" aria-label="Mobile navigation">
        <a href="/" class="serif" style="font-size:34px; color:var(--plum);">Home Sanctuary</a>
        {
          EKAA_SITE.nav.map((item) => (
            <a href={item.href} class="serif" style="font-size:34px; color:var(--plum);">
              {item.label}
            </a>
          ))
        }
        <a href="/contact/" class="serif" style="font-size:34px; color:var(--plum);">Contact</a>
      </nav>

      <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/book/" class="btn btn-primary" style="width:100%;">Book a Private Session</a>
        <a href={whatsappQuickHref} target="_blank" rel="noopener noreferrer" class="btn btn-soft" style="width:100%;">
          Ask Mehak on WhatsApp
        </a>
      </div>
    </div>

    <main id="main-content">
      <slot />
    </main>

    <!-- Calm Sticky Mobile Action Bar -->
    <div class="mobile-sticky-bar" aria-label="Quick booking actions">
      <a href={whatsappQuickHref} target="_blank" rel="noopener noreferrer" style="color:#FAF6F1; font-size:12px; font-weight:600; letter-spacing:0.04em;">
        WhatsApp Concierge
      </a>
      <a href="/book/" class="btn btn-terracotta" style="min-height:38px; padding:8px 18px; font-size:11px;">
        Book Session &rarr;
      </a>
    </div>

    <footer class="site-footer">
      <div class="container">
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap:42px; padding-bottom:48px; border-bottom:1px solid var(--border-dark);">
          <!-- Brand Column -->
          <div style="max-width:300px;">
            <a href="/" style="display:inline-block; margin-bottom:18px;">
              <img src="/brand/ekaa-logo-porcelain.png" alt="EKAA Logo" style="height:78px; width:auto;" />
            </a>
            <p style="font-size:14px; line-height:1.65; color:rgba(250,246,241,0.72); margin:0 0 18px 0;">
              <strong style="color:#FAF6F1;">One Purpose, Many Paths.</strong> Holistic clarity, Vedic Numerology, Reiki healing, and reflective coaching by Mehak Marwaha—in Dubai &amp; worldwide online.
            </p>
            <div style="font-size:12.5px; color:var(--terracotta); font-weight:600;">
              Dubai, UAE &nbsp;·&nbsp; Worldwide Online
            </div>
          </div>

          <!-- Radiance Column -->
          <div>
            <div style="font-size:11px; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--gold); margin-bottom:16px;">
              Ekaa Radiance
            </div>
            <div style="display:flex; flex-direction:column; gap:10px;">
              <a href="/radiance/vedic-numerology/" class="footer-link">Vedic Numerology</a>
              <a href="/radiance/reiki-healing/" class="footer-link">Reiki Healing Energy</a>
              <a href="/radiance/tarot-life-coaching/" class="footer-link">Tarot Life Coaching</a>
              <a href="/radiance/akashic-records/" class="footer-link">Akashic Record Reading</a>
              <a href="/radiance/meditation/" class="footer-link">Meditation &amp; Pendulum</a>
              <a href="/radiance/workshops/" class="footer-link">Transformative Workshops</a>
            </div>
          </div>

          <!-- Founder & Umbrella Column -->
          <div>
            <div style="font-size:11px; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--gold); margin-bottom:16px;">
              Founder &amp; Ekaa Family
            </div>
            <div style="display:flex; flex-direction:column; gap:10px;">
              <a href="/mehak-marwaha/" class="footer-link">Meet Mehak Marwaha</a>
              <a href="/insights/" class="footer-link">Insights &amp; Guides</a>
              <a href="/ekaa-family/" class="footer-link">The EKAA Umbrella</a>
              <a
                href={riseLink.href}
                target={riseLink.external ? '_blank' : undefined}
                rel={riseLink.external ? 'noopener noreferrer' : undefined}
                class="footer-link"
              >
                Ekaa Rise {riseLink.external ? '↗' : '(Launching Soon)'}
              </a>
              <a
                href={rejoiceLink.href}
                target={rejoiceLink.external ? '_blank' : undefined}
                rel={rejoiceLink.external ? 'noopener noreferrer' : undefined}
                class="footer-link"
              >
                Ekaa Rejoice {rejoiceLink.external ? '↗' : '(Launching Soon)'}
              </a>
            </div>
          </div>

          <!-- Connect Column -->
          <div>
            <div style="font-size:11px; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--gold); margin-bottom:16px;">
              Direct Concierge
            </div>
            <div style="display:flex; flex-direction:column; gap:10px;">
              <a href="/book/" class="footer-link" style="color:var(--terracotta); font-weight:600;">Book a Private Session &rarr;</a>
              <a href={`mailto:${EKAA_SITE.email}`} class="footer-link">{EKAA_SITE.email}</a>
              <a href={EKAA_SITE.phoneUAEHref} class="footer-link">UAE: {EKAA_SITE.phoneUAE}</a>
              <a href={EKAA_SITE.phoneIndiaHref} class="footer-link">India: {EKAA_SITE.phoneIndia}</a>
              <a href={EKAA_SITE.verticals.radiance.instagramUrl} target="_blank" rel="noopener noreferrer" class="footer-link">
                Instagram {EKAA_SITE.verticals.radiance.instagramHandle} ↗
              </a>
            </div>
          </div>
        </div>

        <div style="padding-top:24px; display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:14px; font-size:12px; color:rgba(250,246,241,0.52);">
          <div>&copy; {new Date().getFullYear()} EKAA &amp; Mehak Marwaha. Holistic wellness &amp; spiritual coaching—non-medical practice.</div>
          <div style="display:flex; gap:20px;">
            <a href="/privacy-policy/" class="footer-link" style="font-size:12px;">Privacy Policy</a>
            <a href="/terms/" class="footer-link" style="font-size:12px;">Session Terms</a>
            <a href="/contact/" class="footer-link" style="font-size:12px;">Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const header = document.getElementById('site-header');
      const openBtn = document.getElementById('mobile-menu-open');
      const closeBtn = document.getElementById('mobile-menu-close');
      const drawer = document.getElementById('mobile-drawer');

      window.addEventListener(
        'scroll',
        () => {
          if (!header) return;
          header.classList.toggle('scrolled', window.scrollY > 18);
        },
        { passive: true }
      );

      function toggleDrawer(open) {
        if (!drawer || !openBtn) return;
        drawer.classList.toggle('open', open);
        drawer.setAttribute('aria-hidden', String(!open));
        openBtn.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      }

      openBtn?.addEventListener('click', () => toggleDrawer(true));
      closeBtn?.addEventListener('click', () => toggleDrawer(false));
      drawer?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => toggleDrawer(false));
      });
    </script>
  </body>
</html>
