---
import { ArrowUpRight } from 'lucide-astro';
---
<section class="intro" aria-labelledby="radiance-title">
  <div class="container intro-grid">
    <div class="intro-copy">
      <p class="eyebrow">Ekaa Radiance · Dubai &amp; online</p>
      <h1 id="radiance-title">A little space<br />for <em>clarity.</em></h1>
      <p class="lead">Explore a question, settle your thoughts or make time for reflection in a private session with Mehak Marwaha.</p>
      <div class="actions"><a class="btn book" href="/book/">Book a session <ArrowUpRight size={16}/></a><a href="#pathways" class="explore">Explore the practices ↓</a></div>
    </div>
    <img class="lotus" src="/images/lotus-still-life.webp" srcset="/images/lotus-still-life-small.webp 680w, /images/lotus-still-life.webp 1536w" sizes="(max-width: 720px) 100vw, 56vw" width="1536" height="1024" fetchpriority="high" alt="A white lotus floating in a dark stone bowl in the morning light" />
  </div>
</section>
<style>
  .intro { border-bottom:1px solid var(--ink); }
  .intro-grid { display:grid; grid-template-columns: .85fr 1.15fr; align-items:center; gap:clamp(25px,4vw,65px); padding-block:clamp(28px,4vw,62px); }
  h1 { font:500 clamp(3.8rem,6.5vw,6.8rem)/.94 var(--font-serif); letter-spacing:-.045em; margin:22px 0; }
  h1 em { font-weight:400; }
  .lead { max-width:38ch; }
  .actions { display:flex; align-items:center; flex-wrap:wrap; gap:18px; margin-top:26px; }
  .book { background:var(--ink); color:white; border:1px solid var(--ink); }
  .book:hover { color:var(--ink); background:white; }
  .explore { font-size:14px; border-bottom:1px solid; }
  .lotus { width:100%; height:auto; aspect-ratio:1.12; object-fit:cover; }
  @media(max-width:720px){.intro-grid{grid-template-columns:1fr;gap:26px}.lotus{aspect-ratio:1.65}.intro-copy{padding-top:12px}h1{margin-block:15px}}
</style>
