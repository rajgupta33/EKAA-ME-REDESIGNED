---
import { ArrowDown, ArrowUpRight } from 'lucide-astro';
---

<section class="section-dark radiance-hero" aria-labelledby="radiance-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">Ekaa Radiance · By Mehak Marwaha</div>
      <h1 class="h1" id="radiance-title">Find clarity.<br /><em>Come back to you.</em></h1>
      <p class="lead">
        Personalized 1:1 sessions in Vedic Numerology, Reiki Healing, Tarot Life Coaching, and Akashic Readings.
      </p>
      <div class="hero-actions">
        <a href="/radiance/" class="btn btn-terracotta">
          Explore Sessions <ArrowUpRight size={16} aria-hidden="true" />
        </a>
        <a href="/mehak-marwaha/" class="btn btn-outline-light">Meet Mehak</a>
      </div>
      <a class="hero-location" href="#pathways">
        <span class="hero-location-icon"><ArrowDown size={15} aria-hidden="true" /></span>
        Find your starting point
      </a>
    </div>

    <div class="hero-stage" data-hero-stage aria-hidden="true">
      <div class="hero-scene">
        <div class="hero-arch">
          <img
            src="/images/crystal-lotus.webp"
            srcset="/images/crystal-lotus-mobile.webp 560w, /images/crystal-lotus.webp 960w"
            sizes="(min-width: 1100px) 450px, (min-width: 800px) 40vw, calc(100vw - 76px)"
            width="960" height="1200"
            fetchpriority="high"
            alt=""
          />
        </div>
        <span class="hero-orbit"></span>
        <span class="hero-emblem">
          <img src="/brand/ekaa-lotus-gold.png" alt="" width="40" height="30" />
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  const canTilt = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');

  stage?.addEventListener('pointermove', (event) => {
    if (!canTilt.matches || event.pointerType === 'touch') return;

    const bounds = stage.getBoundingClientRect();
    const x = (event.clientX - bounds.left) / bounds.width - 0.5;
    const y = (event.clientY - bounds.top) / bounds.height - 0.5;

    stage.style.setProperty('--tilt-x', `${y * -9}deg`);
    stage.style.setProperty('--tilt-y', `${x * 12}deg`);
  });

  stage?.addEventListener('pointerleave', () => {
    stage.style.removeProperty('--tilt-x');
    stage.style.removeProperty('--tilt-y');
  });
</script>

<style>
  .radiance-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(52px, 6vw, 88px);
    background:
      radial-gradient(ellipse at 77% 46%, #583024 0%, transparent 53%),
      radial-gradient(ellipse at 0% 100%, #38202b 0%, transparent 60%),
      #1b1219;
  }

  .radiance-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: repeating-radial-gradient(ellipse at 76% 65%, transparent 0 54px, #f0bea708 55px 56px);
    mask-image: linear-gradient(110deg, transparent 22%, #000);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(30px, 5vw, 72px);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-copy .eyebrow {
    color: #efbb9f;
    margin-bottom: 24px;
  }

  .hero-copy .h1 {
    font-size: clamp(3.45rem, 6.25vw, 6.15rem);
    line-height: 0.97;
    letter-spacing: -0.045em;
    margin-bottom: 26px;
  }

  .hero-copy .h1 em {
    color: #efb39b;
  }

  .hero-copy .lead {
    max-width: 43ch;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .hero-actions .btn-terracotta {
    background-color: #f0b89f;
  }

  .hero-actions .btn-terracotta:hover {
    background-color: #f8cdb9;
  }

  .hero-location {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
    color: #ead9d2;
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .hero-location-icon {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid #e7a78a60;
    color: #efbb9f;
    border-radius: 50%;
    transition: background-color 250ms ease, transform 250ms var(--ease-silk);
  }

  .hero-location:hover .hero-location-icon {
    background-color: #f3b79c24;
    transform: translateY(3px);
  }

  .hero-stage {
    width: min(100%, 450px);
    margin-inline: auto;
    perspective: 1050px;
  }

  .hero-scene {
    position: relative;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transform-style: preserve-3d;
    transition: transform 400ms var(--ease-silk);
  }

  .hero-arch {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid #e0a27b8c;
    border-radius: 50% 50% 22px 22px / 40% 40% 22px 22px;
    background-color: #41241f;
    box-shadow: 0 24px 55px #10080bb3, 0 0 0 9px #ecc49a0a;
  }

  .hero-arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-arch::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(110deg, transparent 33%, #ffe4bd60 50%, transparent 67%);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero-orbit {
    position: absolute;
    top: 17%;
    left: -5%;
    width: 110%;
    height: 62%;
    border: 1px solid #f6bd887a;
    border-radius: 50%;
    transform: translateZ(23px) rotate(-19deg) rotateX(65deg);
    pointer-events: none;
  }

  .hero-orbit::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -3px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffe2bb;
    box-shadow: 0 0 15px 4px #edb68699;
  }

  .hero-emblem {
    position: absolute;
    right: -14px;
    bottom: 26px;
    display: grid;
    width: clamp(54px, 6vw, 78px);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid #e7bd8980;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 20%, #57362e, #24131c 76%);
    box-shadow: 0 12px 25px #160a10a0, inset 0 0 0 4px #edb68612;
    transform: translateZ(43px);
  }

  .hero-emblem img {
    width: 53%;
    height: auto;
  }

  @media (max-width: 799px) {
    .radiance-hero {
      padding-top: 38px;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }

    .hero-copy .h1 {
      font-size: clamp(3.2rem, 10vw, 5.35rem);
    }

    .hero-stage {
      width: min(calc(100% - 28px), 450px);
    }
  }

  @media (max-width: 480px) {
    .hero-copy .eyebrow { margin-bottom: 19px; }
    .hero-copy .h1 { margin-bottom: 20px; }
    .hero-actions { gap: 8px; margin-top: 22px; }
    .hero-actions .btn { padding-inline: 14px; font-size: 11px; letter-spacing: 0.06em; }
    .hero-location { margin-top: 20px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > *,
    .hero-stage {
      animation: hero-arrival 850ms var(--ease-silk) backwards;
    }

    .hero-copy .h1 { animation-delay: 80ms; }
    .hero-copy .lead { animation-delay: 150ms; }
    .hero-actions { animation-delay: 220ms; }
    .hero-location { animation-delay: 270ms; }
    .hero-stage { animation-delay: 150ms; }
    .hero-arch::after { animation: light-sweep 2.9s 650ms both; }
  }

  @keyframes hero-arrival {
    from { opacity: 0; transform: translateY(15px); }
  }

  @keyframes light-sweep {
    from { transform: translateX(-78%); opacity: 0; }
    35% { opacity: 0.7; }
    to { transform: translateX(85%); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scene,
    .hero-location:hover .hero-location-icon {
      transform: none;
    }
  }
</style>
