---
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionMatcher from '../components/SessionMatcher.astro';
import RadianceHero from '../components/RadianceHero.astro';
import { ArrowUpRight, Compass, Sparkles, Waves } from 'lucide-astro';
import { EKAA_SITE, buildWhatsAppUrl, getVerticalHref } from '../data/site';
import { RADIANCE_SERVICES } from '../data/services';
import { INSIGHT_ARTICLES } from '../data/insights';

const flagshipServices = RADIANCE_SERVICES.filter((s) => s.tier === 'flagship');
const specialtyServices = RADIANCE_SERVICES.filter((s) => s.tier === 'specialty');
const featuredInsights = INSIGHT_ARTICLES.slice(0, 3);

const riseLink = getVerticalHref(EKAA_SITE.verticals.rise);
const rejoiceLink = getVerticalHref(EKAA_SITE.verticals.rejoice);

const homeSchemas = [
  {
    '@type': 'WebSite',
    '@id': `${EKAA_SITE.siteUrl}/#website`,
    url: `${EKAA_SITE.siteUrl}/`,
    name: 'EKAA — Ekaa Radiance by Mehak Marwaha',
    publisher: { '@id': `${EKAA_SITE.siteUrl}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${EKAA_SITE.siteUrl}/#webpage`,
    url: `${EKAA_SITE.siteUrl}/`,
    name: 'Ekaa Radiance | Vedic Numerology, Reiki & Holistic Clarity in Dubai',
    isPartOf: { '@id': `${EKAA_SITE.siteUrl}/#website` },
    about: { '@id': `${EKAA_SITE.siteUrl}/#organization` },
  },
];
---

<BaseLayout
  title="Ekaa Radiance | Vedic Numerology, Reiki & Clarity Coaching in Dubai"
  description="Explore 1:1 Vedic Numerology, Reiki Healing Energy, Tarot Life Coaching & Akashic Readings with founder Mehak Marwaha at Ekaa Radiance—in Dubai and online worldwide."
  canonicalPath="/"
  ogImage="/images/crystal-lotus.webp"
  pageSchemas={homeSchemas}
>
  <RadianceHero />

  <!-- 02 · CREDIBILITY RIBBON -->
  <section class="credibility" aria-label="Ekaa Radiance at a glance">
    <div class="container credibility-items">
      <span><strong>7 Holistic Modalities</strong> · 1:1 &amp; Workshops</span>
      <span><strong>Dubai In-Person</strong> &amp; Global Online</span>
      <span><strong>UCLA-Certified</strong> Career Counselor &amp; Coach</span>
      <span><strong>Attitude of Gratitude</strong> Podcast Guest</span>
    </div>
  </section>

  <!-- 03 · INTENT PATHWAYS -->
  <section class="section pathways" id="pathways">
    <div class="container">
      <div style="max-width:680px; margin-bottom:40px;">
        <div class="eyebrow">BEGIN WITH YOUR MOMENT</div>
        <h2 class="h2">Speak to what you feel, <em>not just a label</em>.</h2>
        <p class="lead">You don’t need to know the exact modality before reaching out. Choose what feels truest today.</p>
      </div>

      <div class="grid-3">
        <a href="/radiance/vedic-numerology/" class="surface-terracotta surface-card interactive pathway-card">
          <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
              <span class="pathway-icon"><Compass size={25} stroke-width={1.35} aria-hidden="true" /></span>
              <span class="pathway-label">Seeking Clarity</span>
            </div>
            <p class="serif" style="font-size:27px; line-height:1.22; color:var(--plum); margin:0 0 12px 0;">
              “I feel at a crossroads and want a grounded, thoughtful perspective.”
            </p>
            <p style="font-size:14px; color:var(--ink-muted); margin:0;">
              Ideal for career transitions, relationship reflection, and understanding personal timing.
            </p>
          </div>
          <div style="border-top:1px solid rgba(181,102,83,0.22); padding-top:14px; display:flex; justify-content:space-between; align-items:center; font-size:13px; font-weight:600; color:var(--terracotta-deep);">
            <span>Vedic Numerology · Tarot · Akashic</span>
            <span>&rarr;</span>
          </div>
        </a>

        <a href="/radiance/reiki-healing/" class="surface-sage surface-card interactive pathway-card">
          <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
              <span class="pathway-icon"><Waves size={25} stroke-width={1.35} aria-hidden="true" /></span>
              <span class="pathway-label">Seeking Calm</span>
            </div>
            <p class="serif" style="font-size:27px; line-height:1.22; color:var(--plum); margin:0 0 12px 0;">
              “I feel emotionally drained and want a quiet space to exhale and reset.”
            </p>
            <p style="font-size:14px; color:var(--ink-muted); margin:0;">
              Ideal for nervous-system rest, stress release, energetic grounding, and stillness.
            </p>
          </div>
          <div style="border-top:1px solid rgba(75,90,68,0.22); padding-top:14px; display:flex; justify-content:space-between; align-items:center; font-size:13px; font-weight:600; color:#4B5A44;">
            <span>Reiki Healing · Meditation · Pendulum</span>
            <span>&rarr;</span>
          </div>
        </a>

        <a href="/radiance/workshops/" class="surface-sand surface-card interactive pathway-card">
          <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
              <span class="pathway-icon"><Sparkles size={25} stroke-width={1.35} aria-hidden="true" /></span>
              <span class="pathway-label">Seeking Connection</span>
            </div>
            <p class="serif" style="font-size:27px; line-height:1.22; color:var(--plum); margin:0 0 12px 0;">
              “I want to learn holistic practices in a warm, supportive circle.”
            </p>
            <p style="font-size:14px; color:var(--ink-muted); margin:0;">
              Ideal for hands-on crystal &amp; mindfulness workshops in Dubai or live online.
            </p>
          </div>
          <div style="border-top:1px solid rgba(143,111,64,0.22); padding-top:14px; display:flex; justify-content:space-between; align-items:center; font-size:13px; font-weight:600; color:var(--gold-text);">
            <span>Transformative &amp; Crystal Workshops</span>
            <span>&rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 04 · SIGNATURE OFFERINGS + INTERACTIVE MATCHER -->
  <section class="section offerings">
    <div class="container">
      <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:20px; margin-bottom:40px;">
        <div>
          <div class="eyebrow">EKAA RADIANCE OFFERINGS</div>
          <h2 class="h2" style="margin-bottom:8px;">Seven modalities, <em>calmly curated</em>.</h2>
          <p class="lead">Begin with one of our three signature 1:1 sessions, or explore specialized energy and workshop circles below.</p>
        </div>
        <a href="/radiance/" class="btn btn-outline">View All 7 Modalities &rarr;</a>
      </div>

      <!-- Flagship 3 Bento Cards -->
      <div class="grid-3" style="margin-bottom:24px;">
        {
          flagshipServices.map((service) => (
            <a href={`/radiance/${service.slug}/`} class="surface-card interactive" style="overflow:hidden; display:flex; flex-direction:column;">
              <div class="offering-image">
                <img src={service.image} alt={service.imageAlt} class="img-zoom" style="width:100%; height:100%; object-fit:cover;" loading="lazy" />
                <span class={`pill pill-${service.theme}`} style="position:absolute; top:14px; left:14px;">
                  {service.intentLabel}
                </span>
                <span class="offering-arrow"><ArrowUpRight size={18} aria-hidden="true" /></span>
              </div>
              <div style="padding:24px; flex:1; display:flex; flex-direction:column; justify-content:space-between; gap:16px;">
                <div>
                  <div style="font-size:11.5px; font-weight:600; color:var(--ink-light); margin-bottom:6px;">{service.duration}</div>
                  <h3 class="h3">{service.name}</h3>
                  <p style="font-size:14.5px; color:var(--ink-muted); margin:0;">{service.tagline}</p>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center; padding-top:14px; border-top:1px solid var(--border); font-size:13px; font-weight:600; color:var(--terracotta-deep);">
                  <span>{service.format}</span>
                  <span>Explore session</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Modular 4 Specialty Offerings -->
      <div class="grid-4" style="margin-bottom:36px;">
        {
          specialtyServices.map((service) => (
            <a href={`/radiance/${service.slug}/`} class="surface-card interactive" style="padding:22px; background:var(--porcelain); display:flex; flex-direction:column; justify-content:space-between; gap:14px;">
              <div>
                <div style="font-size:10.5px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--terracotta-deep); margin-bottom:6px;">
                  {service.duration}
                </div>
                <h3 class="serif" style="font-size:25px; font-weight:600; color:var(--plum); margin:0 0 6px 0; line-height:1.15;">
                  {service.name}
                </h3>
                <p style="font-size:13.5px; color:var(--ink-muted); margin:0;">{service.tagline}</p>
              </div>
              <span style="font-size:12.5px; font-weight:600; color:var(--plum);">Learn more &rarr;</span>
            </a>
          ))
        }
      </div>

      <SessionMatcher />
    </div>
  </section>

  <!-- 05 · MEET MEHAK MARWAHA (FOUNDER PERSONAL BRAND) -->
  <section class="section">
    <div class="container">
      <div class="founder-grid">
        <div>
          <div class="founder-image">
            <img
              src={EKAA_SITE.founder.hasPortraitPhoto ? EKAA_SITE.founder.portraitPath : '/images/reflection-journal.webp'}
              alt={EKAA_SITE.founder.hasPortraitPhoto ? 'Mehak Marwaha, founder of EKAA' : 'An open journal and rose quartz on a sunlit stone desk'}
              style="width:100%; height:100%; object-fit:cover;"
              loading="lazy"
            />
            <div style="position:absolute; left:20px; right:20px; bottom:20px; background:rgba(38,27,34,0.9); backdrop-filter:blur(8px); color:var(--porcelain); border-radius:16px; padding:18px 20px; border:1px solid rgba(213,135,116,0.35);">
              <div style="font-size:10px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:var(--terracotta); margin-bottom:5px;">
                FOUNDER’S GUIDING PROMISE
              </div>
              <p class="serif" style="font-size:22px; font-style:italic; margin:0; line-height:1.25;">
                “{EKAA_SITE.founder.quote}”
              </p>
            </div>
          </div>
        </div>

        <div>
          <div class="eyebrow">MEET THE FOUNDER</div>
          <h2 class="h2">A grounded voice in <em>holistic clarity</em>.</h2>
          <p class="lead" style="margin-bottom:22px;">
            Before founding EKAA (“Oneness”) in Dubai, Mehak Marwaha spent years navigating the corporate world—giving her rare fluency in both practical ambition and quiet spiritual depth.
          </p>

          <div class="grid-2" style="gap:14px; margin-bottom:28px;">
            <div class="surface-sand" style="padding:16px 18px;">
              <div style="font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--gold-text); margin-bottom:4px;">CREDENTIALS</div>
              <div style="font-size:14px; font-weight:600; color:var(--plum);">UCLA-Certified Career Counselor · Vedic Numerology · Reiki · Tarot · Akashic</div>
            </div>
            <div class="surface-terracotta" style="padding:16px 18px;">
              <div style="font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--terracotta-deep); margin-bottom:4px;">PRACTICE ETHOS</div>
              <div style="font-size:14px; font-weight:600; color:var(--plum);">Non-predictive, confidential, deeply respectful of your personal agency</div>
            </div>
          </div>

          <div style="display:flex; flex-wrap:wrap; gap:14px;">
            <a href="/mehak-marwaha/" class="btn btn-primary">Read Mehak’s Story &rarr;</a>
            <a href="/book/" class="btn btn-outline">Book 1:1 With Mehak</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 · HOW SESSIONS WORK -->
  <section class="section-tight" style="background:var(--sand); border-top:1px solid var(--border); border-bottom:1px solid var(--border);">
    <div class="container">
      <div style="text-align:center; max-width:640px; margin:0 auto 40px auto;">
        <div class="eyebrow" style="justify-content:center;">A CALM, TRANSPARENT RITUAL</div>
        <h2 class="h2">How every session unfolds.</h2>
      </div>

      <div class="grid-4">
        <div class="surface-card" style="padding:24px;">
          <div class="serif" style="font-size:32px; color:var(--terracotta-deep); margin-bottom:8px;">01</div>
          <h3 style="font-size:17px; font-weight:700; color:var(--plum); margin:0 0 6px 0;">Choose Your Path</h3>
          <p style="font-size:14px; color:var(--ink-muted); margin:0;">Pick a modality—or use the matcher / WhatsApp concierge if you want gentle guidance.</p>
        </div>
        <div class="surface-card" style="padding:24px;">
          <div class="serif" style="font-size:32px; color:var(--terracotta-deep); margin-bottom:8px;">02</div>
          <h3 style="font-size:17px; font-weight:700; color:var(--plum); margin:0 0 6px 0;">Select Slot &amp; Format</h3>
          <p style="font-size:14px; color:var(--ink-muted); margin:0;">Book Online Video (worldwide timezone) or Dubai In-Person in under two minutes.</p>
        </div>
        <div class="surface-card" style="padding:24px;">
          <div class="serif" style="font-size:32px; color:var(--terracotta-deep); margin-bottom:8px;">03</div>
          <h3 style="font-size:17px; font-weight:700; color:var(--plum); margin:0 0 6px 0;">Simple Preparation</h3>
          <p style="font-size:14px; color:var(--ink-muted); margin:0;">Receive confirmation, prep notes (like birth details for Numerology), and a calm checklist.</p>
        </div>
        <div class="surface-card" style="padding:24px;">
          <div class="serif" style="font-size:32px; color:var(--terracotta-deep); margin-bottom:8px;">04</div>
          <h3 style="font-size:17px; font-weight:700; color:var(--plum); margin:0 0 6px 0;">Reflect &amp; Integrate</h3>
          <p style="font-size:14px; color:var(--ink-muted); margin:0;">Experience an unhurried 1:1 session and leave with grounded clarity you can actually live by.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 · MEDIA FEATURE & TRUST COMMITMENT -->
  <section class="section">
    <div class="container">
      <div class="grid-2" style="align-items:stretch;">
        <div class="surface-dark" style="padding:36px; display:flex; flex-direction:column; justify-content:space-between; gap:20px;">
          <div>
            <span class="pill" style="background:rgba(213,135,116,0.2); color:var(--terracotta); margin-bottom:16px;">FEATURED MEDIA CONVERSATION</span>
            <h2 class="h2" style="font-size:36px; margin-bottom:12px;">
              {EKAA_SITE.founder.podcastFeature.title}
            </h2>
            <p style="font-size:15px; color:rgba(250,246,241,0.8); margin:0;">
              {EKAA_SITE.founder.podcastFeature.note} Recorded {EKAA_SITE.founder.podcastFeature.date}.
            </p>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:12px; justify-content:space-between; align-items:center; padding-top:16px; border-top:1px solid var(--border-dark);">
            <span style="font-size:13px; color:var(--gold);">Listen &amp; read takeaways on Mehak’s page</span>
            <a href="/mehak-marwaha/#media" class="btn btn-terracotta" style="min-height:42px; padding:9px 20px;">View Feature &rarr;</a>
          </div>
        </div>

        <div class="surface-card" style="padding:36px; display:flex; flex-direction:column; justify-content:space-between; gap:20px;">
          <div>
            <span class="pill pill-sage" style="margin-bottom:16px;">ETHICAL TRUST STANDARD</span>
            <h2 class="h2" style="font-size:34px; margin-bottom:12px;">Why clients feel safe here.</h2>
            <p style="font-size:15px; color:var(--ink-muted); margin:0;">
              Ekaa Radiance never uses fear-based hooks, fabricated testimonials, or unrealistic miracle claims. Every session is confidential, transparent on format and policy, and focused on your inner steadiness.
            </p>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:10px;">
            <span class="pill pill-sand">Confidential 1:1 Space</span>
            <span class="pill pill-sand">Non-Medical Wellness</span>
            <span class="pill pill-sand">24h Clear Rescheduling</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 · INSIGHTS PREVIEW -->
  <section class="section-tight" style="background:var(--ivory); border-top:1px solid var(--border); border-bottom:1px solid var(--border);">
    <div class="container">
      <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:16px; margin-bottom:34px;">
        <div>
          <div class="eyebrow">JOURNAL &amp; QUESTIONS ANSWERED</div>
          <h2 class="h2" style="margin-bottom:0;">Clarity <em>Insights</em> by Mehak.</h2>
        </div>
        <a href="/insights/" class="btn btn-outline">Read All Guides &rarr;</a>
      </div>

      <div class="grid-3">
        {
          featuredInsights.map((post) => (
            <a href={`/insights/${post.slug}/`} class="surface-card interactive" style="padding:26px; background:var(--porcelain); display:flex; flex-direction:column; justify-content:space-between; gap:16px;">
              <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                  <span class="pill pill-terracotta">{post.cluster}</span>
                  <span style="font-size:12px; color:var(--ink-light);">{post.readTime}</span>
                </div>
                <h3 class="serif" style="font-size:25px; font-weight:600; color:var(--plum); margin:0 0 10px 0; line-height:1.18;">
                  {post.title}
                </h3>
                <p style="font-size:14px; color:var(--ink-muted); margin:0;">{post.excerpt}</p>
              </div>
              <span style="font-size:13px; font-weight:600; color:var(--terracotta-deep);">Read guide &rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 09 · THE EKAA FAMILY UMBRELLA + FINAL INVITATION -->
  <section class="section">
    <div class="container">
      <div style="text-align:center; max-width:720px; margin:0 auto 42px auto;">
        <div class="eyebrow" style="justify-content:center;">THE EKAA UMBRELLA</div>
        <h2 class="h2">One purpose, <em>three living paths</em>.</h2>
        <p class="lead" style="margin:0 auto;">
          <strong>ekaa.me</strong> is the flagship sanctuary for <strong>Ekaa Radiance</strong>. Its sister verticals—<strong>Ekaa Rise</strong> and <strong>Ekaa Rejoice</strong>—are growing into their own dedicated websites.
        </p>
      </div>

      <div class="grid-3" style="margin-bottom:56px;">
        <div class="surface-terracotta" style="padding:28px; border:2px solid var(--terracotta); display:flex; flex-direction:column; justify-content:space-between; gap:18px;">
          <div>
            <div class="home-brand">
              <img class="vertical-logo" src={EKAA_SITE.verticals.radiance.logoPath} width="250" height="250" alt="" loading="lazy" />
              <span class="pill pill-plum">YOU ARE HERE</span>
              <span style="font-size:12px; font-weight:700; color:var(--terracotta-deep);">ekaa.me</span>
            </div>
            <h3 class="h3">{EKAA_SITE.verticals.radiance.name}</h3>
            <p style="font-size:14px; color:var(--ink-muted); margin:0;">{EKAA_SITE.verticals.radiance.summary}</p>
          </div>
          <a href="/radiance/" style="font-size:13px; font-weight:700; color:var(--terracotta-deep);">Explore Radiance &rarr;</a>
        </div>

        <div class="surface-sage" style="padding:28px; display:flex; flex-direction:column; justify-content:space-between; gap:18px;">
          <div>
            <div class="home-brand">
              <img class="vertical-logo" src={EKAA_SITE.verticals.rise.logoPath} width="250" height="250" alt="" loading="lazy" />
              <span class="pill" style="background:var(--ivory); color:#465440;">{EKAA_SITE.verticals.rise.statusLabel}</span>
            </div>
            <h3 class="h3">{EKAA_SITE.verticals.rise.name}</h3>
            <p style="font-size:14px; color:var(--ink-muted); margin:0;">{EKAA_SITE.verticals.rise.summary}</p>
          </div>
          <a
            href={riseLink.href}
            target={riseLink.external ? '_blank' : undefined}
            rel={riseLink.external ? 'noopener noreferrer' : undefined}
            style="font-size:13px; font-weight:700; color:#465440;"
          >
            {riseLink.external ? 'Visit Ekaa Rise ↗' : 'View Ekaa Rise Details →'}
          </a>
        </div>

        <div class="surface-sand" style="padding:28px; display:flex; flex-direction:column; justify-content:space-between; gap:18px;">
          <div>
            <div class="home-brand">
              <img class="vertical-logo" src={EKAA_SITE.verticals.rejoice.logoPath} width="250" height="250" alt="" loading="lazy" />
              <span class="pill" style="background:var(--ivory); color:var(--gold-text);">{EKAA_SITE.verticals.rejoice.statusLabel}</span>
            </div>
            <h3 class="h3">{EKAA_SITE.verticals.rejoice.name}</h3>
            <p style="font-size:14px; color:var(--ink-muted); margin:0;">{EKAA_SITE.verticals.rejoice.summary}</p>
          </div>
          <a
            href={rejoiceLink.href}
            target={rejoiceLink.external ? '_blank' : undefined}
            rel={rejoiceLink.external ? 'noopener noreferrer' : undefined}
            style="font-size:13px; font-weight:700; color:var(--gold-text);"
          >
            {rejoiceLink.external ? 'Visit Ekaa Rejoice ↗' : 'View Ekaa Rejoice Details →'}
          </a>
        </div>
      </div>

      <!-- Final Calm Invitation -->
      <div class="surface-dark closing-invitation">
        <img src="/brand/ekaa-lotus-terracotta.png" alt="" style="height:36px; margin:0 auto 16px auto;" />
        <h2 class="h2" style="margin-bottom:12px;">Ready for a calmer, <em>clearer</em> conversation?</h2>
        <p class="lead" style="margin:0 auto 28px auto; color:rgba(250,246,241,0.78);">
          Book your private 1:1 session online or in Dubai, or message Mehak directly if you’d like help deciding which session fits best.
        </p>
        <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:14px;">
          <a href="/book/" class="btn btn-terracotta">Book a Private Session &rarr;</a>
          <a
            href={buildWhatsAppUrl('Hi Mehak, I visited ekaa.me and would love guidance on booking a session.')}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-light"
          >
            Message on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (motion.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        if (!isIntersecting) continue;

        target.classList.add('has-entered');
        observer.unobserve(target);
      }
    }, { threshold: 0.15 });

    document.querySelectorAll('.pathway-card, .offering-image, .founder-image, .closing-invitation')
      .forEach((element) => observer.observe(element));
