---
import BaseLayout from '../layouts/BaseLayout.astro';

import RadianceHero from '../components/RadianceHero.astro';
import { ArrowUpRight } from 'lucide-astro';
import { EKAA_SITE } from '../data/site';
import { RADIANCE_SERVICES } from '../data/services';
import { INSIGHT_ARTICLES } from '../data/insights';

const homeSchemas = [
  {
    '@type': 'WebSite',
    '@id': `${EKAA_SITE.siteUrl}/#website`,
    url: `${EKAA_SITE.siteUrl}/`,
    name: 'EKAA — Ekaa Radiance by Mehak Marwaha',
    publisher: { '@id': `${EKAA_SITE.siteUrl}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${EKAA_SITE.siteUrl}/#webpage`,
    url: `${EKAA_SITE.siteUrl}/`,
    name: 'Ekaa Radiance | Vedic Numerology, Reiki & Holistic Clarity in Dubai',
    isPartOf: { '@id': `${EKAA_SITE.siteUrl}/#website` },
    about: { '@id': `${EKAA_SITE.siteUrl}/#organization` },
  },
];
---

<BaseLayout
  title="Ekaa Radiance | Vedic Numerology, Reiki & Clarity Coaching in Dubai"
  description="Explore 1:1 Vedic Numerology, Reiki Healing Energy, Tarot Life Coaching & Akashic Readings with founder Mehak Marwaha at Ekaa Radiance—in Dubai and online worldwide."
  canonicalPath="/"
  ogImage="/images/lotus-still-life.webp"
  pageSchemas={homeSchemas}
>
  <RadianceHero />


  <section id="pathways" class="container collection">
    <header class="section-heading">
      <div><p class="eyebrow">Private sessions</p><h2 class="h2">Explore the practices</h2></div>
      <a class="editorial-link" href="/radiance/">View all seven practices <ArrowUpRight size={18} /></a>
    </header>
    <div class="practice-grid">
      {RADIANCE_SERVICES.slice(0,3).map(service => (
        <a class="practice" href={`/radiance/${service.slug}/`}>
          <div class="practice-photo"><img src={service.image} alt={service.imageAlt} loading="lazy" width="760" height="540" /></div>
          <div class="practice-label"><h3>{service.shortName}</h3><ArrowUpRight size={20} /></div>
          <p>{service.duration}</p>
        </a>
      ))}
    </div>
    <a class="matcher-link" id="session-matcher" href="/radiance/#session-matcher">Unsure which session suits you? Try the session finder <span aria-hidden="true">→</span></a>
  </section>
  <section class="founder-band">
    <div class="container founder-layout">
      <figure class="founder-portrait"><img src={EKAA_SITE.founder.portraitPath} width="832" height="1042" loading="lazy" alt="Mehak Marwaha" /></figure>
      <div><p class="eyebrow">Meet your practitioner</p><h2 class="h2">Mehak Marwaha</h2>
        <blockquote>“{EKAA_SITE.founder.quote}”</blockquote>
        <p class="founder-note">Mehak founded EKAA in Dubai. Her private sessions bring together numerology, Reiki and reflective coaching.</p>
        <a class="editorial-link" href="/mehak-marwaha/">Read Mehak’s story <ArrowUpRight size={18} /></a>
      </div>
    </div>
  </section>
  <section class="container collection journal">
    <header class="section-heading"><div><p class="eyebrow">Mehak’s journal</p><h2 class="h2">Before your first session</h2></div>
      <a class="editorial-link" href="/insights/">All guides <ArrowUpRight size={18} /></a></header>
    {INSIGHT_ARTICLES.slice(0,3).map(post => (
      <a class="journal-row" href={`/insights/${post.slug}/`}><span>{post.cluster}</span><h3>{post.title}</h3><ArrowUpRight size={20} /></a>
    ))}
  </section>
</BaseLayout>
<style>
  .collection { padding-block: clamp(48px,7vw,96px); }
  .section-heading,.practice-label,.editorial-link,.matcher-link,.journal-row { display:flex; align-items:center; gap:12px; }
  .section-heading,.practice-label { justify-content:space-between; }
  .section-heading { flex-wrap:wrap; margin-bottom:30px; align-items:end; }
  .section-heading h2,.practice h3,.journal h3 { margin:0; }
  .editorial-link,.matcher-link { font-size:14px; font-weight:600; }
  .editorial-link { width:fit-content; border-bottom:1px solid; padding-bottom:4px; }
  .practice-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(16px,2.5vw,36px); }
  .practice-photo { overflow:hidden; background:var(--sand); }
  .practice-photo img { width:100%; height:auto; aspect-ratio:1.32; object-fit:cover; transition:transform .4s ease; }
  .practice:hover img { transform:scale(1.035); }
  .practice-label { margin-top:14px; }
  .practice h3,.journal h3 { font:500 clamp(1.5rem,2.4vw,2.25rem)/1.1 var(--font-serif); }
  .practice p,.journal-row span { color:var(--ink-muted);font-size:13px; }
  .practice p { margin:6px 0 0; }
  .matcher-link { margin-top:32px; border-top:1px solid var(--border); padding-top:18px; }
  .founder-band { background:#f6f5f2; }
  .founder-layout { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.25fr); align-items:center; gap:clamp(24px,8vw,100px); padding-block:clamp(38px,5vw,68px); }
  .founder-portrait { border-radius:0; max-width:370px; border:0; }
  blockquote { margin:24px 0; font:italic 400 clamp(1.9rem,3.2vw,3.25rem)/1.1 var(--font-serif); max-width:21ch; }
  .founder-note { max-width:43ch; margin:0 0 22px; color:var(--ink-muted); }
  .journal-row { padding-block:22px; border-top:1px solid var(--border); }
  .journal-row span { flex:0 0 18%; }
  .journal-row svg { margin-left:auto; flex-shrink:0; }
  @media(max-width:680px){
    .practice-grid,.founder-layout { grid-template-columns:1fr; }
    .practice-grid { gap:24px; }
    .founder-portrait { width:75%; }
    .journal-row { display:grid; grid-template-columns:1fr auto; gap:4px; }
    .journal-row span { grid-column:1/-1; }
  }
  @media(prefers-reduced-motion:reduce){.practice-photo img{transition:none}.practice:hover img{transform:none}}
</style>
