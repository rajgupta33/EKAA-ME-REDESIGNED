---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Ekaa Radiance"
  description="Return to the Ekaa Radiance home sanctuary, explore sessions, or meet founder Mehak Marwaha."
>
  <section class="section">
    <div class="container" style="max-width:660px; text-align:center;">
      <img src="/brand/ekaa-lotus-terracotta.png" alt="" style="height:48px; margin:0 auto 20px auto;" />
      <div class="eyebrow" style="justify-content:center;">404 · PATH SHIFTED</div>
      <h1 class="h1" style="font-size:52px;">This page has moved to a <em>calmer space</em>.</h1>
      <p class="lead" style="margin:0 auto 28px auto;">
        Let’s guide you gently back to Ekaa Radiance, Mehak Marwaha’s story, or session booking.
      </p>
      <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:12px;">
        <a href="/" class="btn btn-primary">Return Home &rarr;</a>
        <a href="/radiance/" class="btn btn-soft">Explore Radiance</a>
        <a href="/book/" class="btn btn-outline">Book a Session</a>
      </div>
    </div>
  </section>
</BaseLayout>
